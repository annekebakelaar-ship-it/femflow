# FemFlow frontend environment (Vite: alleen VITE_* wordt in de bundle opgenomen)
# Deze waarden worden tijdens de build ge-inlined — ook op Vercel instellen
# (Project Settings -> Environment Variables) en daarna opnieuw deployen.

# Backend API (Render)
VITE_API_URL=https://femflow-api.onrender.com

# Google OAuth Client ID (Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
