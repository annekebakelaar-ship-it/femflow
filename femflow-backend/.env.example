# Server
NODE_ENV=production
PORT=5000

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/femflow

# Authentication
JWT_SECRET=your-secret-key-here-min-32-chars

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@femflow.youcaps.app

# Oura Ring OAuth
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_REDIRECT_URI=https://femflow-api.onrender.com/api/v1/wearable/callback

# Frontend URL (for CORS & redirects)
FRONTEND_URL=https://femflow-two.vercel.app
