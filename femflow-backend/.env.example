# Server
NODE_ENV=production
PORT=5000

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/femflow

# Authentication
JWT_SECRET=your-secret-key-here-min-32-chars

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@femflow.youcaps.app

# Oura Ring OAuth
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_REDIRECT_URI=https://femflow-api.onrender.com/api/v1/wearable/callback

# Persoonlijke agent: laat dit uit staan tot de module bewust aan mag.
# Alleen de exacte waarde true schakelt hem in.
AGENT_ENABLED=false

# Zout voor de auditpseudoniemen. Zonder deze waarde logt de agent wel, maar
# met een zout dat per processtart verschilt. Zet een lange willekeurige reeks.
AGENT_AUDIT_SALT=

# Persoonlijke MCP-laag met OAuth (fase 2). Apart van AGENT_ENABLED en ook
# standaard uit. Aanzetten heeft alleen zin met een sleutelpaar en minstens
# een geregistreerde client.
AGENT_OAUTH_ENABLED=false
AGENT_OAUTH_ISSUER=https://femflow-api.onrender.com
AGENT_OAUTH_RESOURCE=https://femflow-api.onrender.com/api/v1/agent/oauth/mcp
# PEM-sleutelpaar, RS256. Genereer met:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out prive.pem
#   openssl rsa -in prive.pem -pubout -out publiek.pem
AGENT_OAUTH_PRIVATE_KEY=
AGENT_OAUTH_PUBLIC_KEY=
# Oude publieke sleutels tijdens een rotatie, gescheiden door |||. Alleen voor
# verificatie; ondertekenen gebeurt altijd met de huidige prive-sleutel.
# Zie agent/SLEUTELROTATIE.md.
AGENT_OAUTH_PUBLIC_KEYS_OUD=
# JSON-lijst, bijvoorbeeld:
# [{"id":"chatgpt","naam":"ChatGPT","redirectUris":["https://chatgpt.com/connector_platform_oauth_redirect"]}]
# Hosts die een client_id-metadatadocument (CIMD) mogen aanbieden. Leeg = dicht.
# Voor ChatGPT: chatgpt.com
AGENT_OAUTH_CIMD_HOSTS=
AGENT_OAUTH_CLIENTS=

# Frontend URL (for CORS & redirects)
FRONTEND_URL=https://femflow-two.vercel.app

# Google sign-in (ID-token validatie; zelfde client ID als frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Fitbit (OAuth via Google — Fitbit is van Google; zelfde Cloud-project)
FITBIT_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FITBIT_CLIENT_SECRET=your-google-client-secret
FITBIT_REDIRECT_URI=https://femflow-api.onrender.com/api/v1/wearable/fitbit/callback
