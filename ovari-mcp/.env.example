# Poort waarop de MCP-server luistert. Render vult deze zelf in.
PORT=5100

# Extra origins die een browser mag gebruiken, gescheiden door komma's.
# chatgpt.com, chat.openai.com en claude.ai staan al standaard toegestaan.
# Voor lokaal testen met een browsergebaseerde inspector:
# ALLOWED_ORIGINS=http://localhost:6274
ALLOWED_ORIGINS=

# Deze dienst heeft GEEN databaseverbinding, GEEN JWT-geheim en GEEN
# API-sleutels nodig. Staat hier iets van dien aard, dan hoort het er niet.
